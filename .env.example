# ─── SUPABASE (free at supabase.com) ─────────────────────────────────────────
# 1. Go to https://supabase.com → New Project
# 2. Settings → API → copy Project URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── CLOUDINARY (free at cloudinary.com) ─────────────────────────────────────
# 1. Go to https://cloudinary.com → Dashboard → copy Cloud Name
# 2. Settings → Upload → Add upload preset → set to "Unsigned" → copy preset name
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ─── EMAIL (Resend - free at resend.com) ─────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@gemessence.co.ke

# ─── API BASE URL (for GitHub Pages with remote backend) ────────────────────
# When deploying frontend to GitHub Pages and backend elsewhere
# Set this to your backend URL (e.g., https://your-app.vercel.app)
VITE_API_BASE_URL=

# ─── SERVER (only needed for local dev / self-hosted) ─────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/gemessence
ADMIN_PASSWORD=your_secure_admin_password
SUPERUSER_PASSWORD=your_secure_superuser_password
ADMIN_EMAIL=admin@gemessence.co.ke
PORT=5000
NODE_ENV=development
